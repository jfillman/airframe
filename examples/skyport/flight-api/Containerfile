# Thin packaging image: build.sh has already produced target/*.jar (natively, in the build agent).
# This runs once per architecture (arm64 native, amd64 emulated), so it must stay cheap: no
# compiling here.
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
RUN apk upgrade --no-cache
COPY target/*.jar app.jar
EXPOSE 8080
CMD ["java", "-jar", "app.jar"]
