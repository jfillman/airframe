#!/usr/bin/env python3
"""airframe validate (v0, AF-4a).

Checks an environment values file against a STRICT form of the chart's values.schema.json
and then renders it with `helm template`. Strict means: every object schema that lists
`properties` and does not say otherwise rejects unknown keys, so a typo such as `rolout:`
fails here instead of being silently ignored by the chart. Objects with no `properties`
(passthroughs such as podSpec or extraManifests items) stay open.

    tools/airframe-validate FILE [FILE...] [--app NAME] [--cluster NAME] [--no-render]

Exit 0 = all files valid, 1 = a problem (each printed as: path | rule | message | hint).
Rules: AF-SCHEMA-001 unknown key, AF-SCHEMA-002 wrong type/value, AF-RENDER-001 helm failed,
AF-OWNER-001 (warning until the release-file split lands, then an error): a release-owned key (`release`,
`releaseTracking`, the deprecated `rollout.image`) in a human file, or anything else in a release file.
A release file is named `*.release.yaml` or `release.yaml`.
Needs: python3, pyyaml, jsonschema, helm (unless --no-render).
"""
import argparse
import copy
import difflib
import json
import subprocess
import sys
import tempfile
from pathlib import Path

import yaml
from jsonschema import Draft202012Validator

ROOT = Path(__file__).resolve().parent.parent
CHART = ROOT / "charts" / "airframe-application"


def component_schemas():
    """component `type` (lowercase kind) -> strict spec schema from xrds/*.yaml."""
    out = {}
    for f in (ROOT / "xrds").glob("*.yaml"):
        d = yaml.safe_load(f.read_text())
        spec = d["spec"]["versions"][0]["schema"]["openAPIV3Schema"]["properties"]["spec"]
        out[d["spec"]["names"]["kind"].lower()] = (spec, strictify(spec))
    return out


def strictify(node):
    """Return a copy of the schema with additionalProperties:false on closed objects."""
    node = copy.deepcopy(node)

    def go(n):
        if isinstance(n, dict):
            if isinstance(n.get("properties"), dict) and "additionalProperties" not in n \
                    and "patternProperties" not in n:
                n["additionalProperties"] = False
            for v in n.values():
                go(v)
        elif isinstance(n, list):
            for v in n:
                go(v)
    go(node)
    return node


def known_keys(schema, instance_path):
    """Keys the schema allows at the object the error points into (for typo hints)."""
    node = schema
    for p in instance_path:
        if isinstance(node, dict) and "properties" in node and p in node["properties"]:
            node = node["properties"][p]
        elif isinstance(node, dict) and isinstance(node.get("items"), dict) and isinstance(p, int):
            node = node["items"]
        else:
            return []
    return list(node.get("properties", {})) if isinstance(node, dict) else []


RELEASE_KEYS = {"release", "releaseTracking"}


def is_release_file(path):
    n = Path(path).name
    return n.endswith(".release.yaml") or n == "release.yaml"


def ownership_warnings(path, data):
    """AF-OWNER-001. Returns (loc, rule, message, hint) tuples; reported as warnings."""
    out = []
    if not isinstance(data, dict):
        return out
    if is_release_file(path):
        for k in data:
            ok = k in RELEASE_KEYS or (k == "rollout" and isinstance(data[k], dict) and set(data[k]) <= {"image"})
            if not ok:
                out.append((f"/{k}", "AF-OWNER-001", f"'{k}' does not belong in a release file",
                            "a release file holds only release, releaseTracking (and the deprecated rollout.image)"))
    else:
        for k in RELEASE_KEYS & set(data):
            out.append((f"/{k}", "AF-OWNER-001", f"'{k}' is release-owned but is in a human-owned file",
                        "it belongs in the release file, written by the release pipeline"))
        if isinstance(data.get("rollout"), dict) and "image" in data["rollout"]:
            out.append(("/rollout/image", "AF-OWNER-001", "rollout.image is deprecated and release-owned",
                        "use release.image, in the release file"))
    return out


def check_file(path, schema, strict, args):
    problems = []
    try:
        data = yaml.safe_load(Path(path).read_text())
    except yaml.YAMLError as e:
        return [(str(path), "AF-SCHEMA-002", f"not valid YAML: {e}", "fix the YAML syntax")]
    if data is None:
        data = {}
    v = Draft202012Validator(strict)
    for err in sorted(v.iter_errors(data), key=lambda e: list(map(str, e.absolute_path))):
        loc = "/" + "/".join(map(str, err.absolute_path))
        loc = loc.rstrip("/") if loc != "/" else ""
        if err.validator == "additionalProperties":
            allowed = known_keys(schema, list(err.absolute_path))
            for bad in [k for k in err.instance if k not in allowed]:
                near = difflib.get_close_matches(bad, allowed, n=1)
                hint = f"did you mean '{near[0]}'?" if near else "no such field; see values.schema.json"
                problems.append((f"{loc}/{bad}", "AF-SCHEMA-001", f"unknown key '{bad}'", hint))
        else:
            problems.append((loc, "AF-SCHEMA-002", err.message[:160], "see the field's schema in values.schema.json"))
    # components[].spec is a passthrough in values.schema.json: check it against the XRD.
    comps = component_schemas()
    for i, c in enumerate(data.get("components") or []):
        if not isinstance(c, dict):
            continue
        kind = str(c.get("type", "")).lower()
        if kind not in comps:
            problems.append((f"/components/{i}/type", "AF-SCHEMA-002", f"unknown component type '{c.get('type')}'",
                             "one of: " + ", ".join(sorted(k for k in comps if k in ("redis", "postgresql", "rabbitmq")))))
            continue
        raw, strict_spec = comps[kind]
        spec = dict(c.get("spec") or {})
        spec.setdefault("environmentRef", {"name": "stamped-by-the-chart"})
        for err in Draft202012Validator(strict_spec).iter_errors(spec):
            loc = f"/components/{i}/spec" + "".join("/" + str(x) for x in err.absolute_path)
            if err.validator == "additionalProperties":
                allowed = known_keys(raw, list(err.absolute_path))
                for bad in [k for k in err.instance if k not in allowed]:
                    near = difflib.get_close_matches(bad, allowed, n=1)
                    problems.append((f"{loc}/{bad}", "AF-SCHEMA-001", f"unknown key '{bad}'",
                                     f"did you mean '{near[0]}'?" if near else f"see xrds/{kind}.yaml"))
            else:
                problems.append((loc, "AF-SCHEMA-002", err.message[:160], f"see xrds/{kind}.yaml"))
    if not problems and not args.no_render:
        parents = Path(path).resolve().parents
        app = args.app or (parents[2].name if len(parents) > 2 else None)
        with tempfile.TemporaryDirectory() as td:
            base = Path(td) / "base.yaml"
            base.write_text(yaml.safe_dump({"appName": app or "validate", "cluster": args.cluster,
                                            "envName": data.get("envName", "dev")}))
            r = subprocess.run(["helm", "template", "validate", str(CHART), "-f", str(base), "-f", str(path)],
                               capture_output=True, text=True)
            if r.returncode != 0:
                msg = (r.stderr.strip().splitlines() or ["helm failed"])[-1][:200]
                problems.append(("/", "AF-RENDER-001", msg, "fix the value the message names, then re-run"))
    return problems


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("files", nargs="+")
    ap.add_argument("--app")
    ap.add_argument("--cluster", default="kind-dev")
    ap.add_argument("--no-render", action="store_true")
    a = ap.parse_args()
    schema = json.loads((CHART / "values.schema.json").read_text())
    strict = strictify(schema)
    bad = 0
    for f in a.files:
        probs = check_file(f, schema, strict, a)
        try:
            warns = ownership_warnings(f, yaml.safe_load(Path(f).read_text()))
        except Exception:
            warns = []
        if probs:
            bad += 1
            print(f"FAIL {f}")
            for loc, rule, msg, hint in probs:
                print(f"  {loc} | {rule} | {msg} | {hint}")
        else:
            print(f"ok   {f}")
        for loc, rule, msg, hint in warns:
            print(f"  warn {loc} | {rule} | {msg} | {hint}")
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main())
