# --- Markdown to HTML (the subset the guides use) ------------------------------------------------

def link_target(url, html_names):
    if re.match(r"[a-z]+:", url) or url.startswith("#"):
        return url
    base, _, anchor = url.partition("#")
    if base in html_names:
        return base[:-3] + ".html" + (f"#{anchor}" if anchor else "")
    if base.endswith(".md") or base.startswith("../"):
        return REPO_BLOB + base + (f"#{anchor}" if anchor else "")
    return url


def inline(s, html_names):
    codes = []

    def keep(m):
        codes.append(f"<code>{esc(m.group(1))}</code>")
        return f"\x00{len(codes) - 1}\x00"

    s = re.sub(r"`([^`]+)`", keep, s)
    s = esc(s)
    s = re.sub(r"&lt;(https?://[^&\s]+)&gt;", r'<a href="\1">\1</a>', s)
    s = re.sub(r"\[([^\]]+)\]\(([^)\s]+)\)",
               lambda m: f'<a href="{link_target(html.unescape(m.group(2)), html_names)}">{m.group(1)}</a>', s)
    s = re.sub(r"\*\*(.+?)\*\*", r"<b>\1</b>", s)
    s = re.sub(r"(?<![\w*])\*([^*\s][^*]*?)\*(?![\w*])", r"<em>\1</em>", s)
    s = s.replace("→", '<span class="arr">→</span>')
    return re.sub(r"\x00(\d+)\x00", lambda m: codes[int(m.group(1))], s)


def highlight(code, lang):
    out = []
    for line in code.split("\n"):
        line = esc(line)
        if lang in ("yaml", "bash"):
            m = re.search(r"(^|\s)(#.*)$", line)
            if m:
                line = line[:m.start(2)] + f'<span class="c">{m.group(2)}</span>'
        out.append(line)
    return "\n".join(out)


def blocks(lines, ctx):
    """Parse a list of Markdown lines into HTML."""
    out, i = [], 0
    while i < len(lines):
        line = lines[i]
        if not line.strip():
            i += 1
            continue
        if line.startswith("```"):
            info = line[3:].strip()
            lang = info.split()[0] if info else ""
            t = re.search(r'title="([^"]+)"', info)
            j = i + 1
            while not lines[j].startswith("```"):
                j += 1
            code = "\n".join(lines[i + 1:j])
            head = f'<span class="filepath">{esc(t.group(1))}</span>' if t else ""
            out.append(f'<div class="code">{head}<pre>{highlight(code, lang)}</pre></div>')
            i = j + 1
            continue
        if line.startswith("#"):
            level = len(line) - len(line.lstrip("#"))
            out.append(f"<h{level + 1}>{inline(line[level:].strip(), ctx)}</h{level + 1}>")
            i += 1
            continue
        if line.startswith(">"):
            j = i
            inner = []
            while j < len(lines) and lines[j].startswith(">"):
                inner.append(re.sub(r"^> ?", "", lines[j]))
                j += 1
            out.append(callout(inner, ctx))
            i = j
            continue
        if line.startswith("|") and i + 1 < len(lines) and re.match(r"^\|[-| :]+\|$", lines[i + 1]):
            j = i
            rows = []
            while j < len(lines) and lines[j].startswith("|"):
                rows.append([c.strip() for c in lines[j].strip().strip("|").split("|")])
                j += 1
            head = "".join(f"<th>{inline(c, ctx)}</th>" for c in rows[0])
            body = "".join("<tr>" + "".join(
                f'<td{" class=name" if k == 0 else ""}>{inline(c, ctx)}</td>' for k, c in enumerate(r)) + "</tr>"
                for r in rows[2:])
            out.append(f'<div class="table-scroll"><table><thead><tr>{head}</tr></thead><tbody>{body}</tbody></table></div>')
            i = j
            continue
        m = re.match(r"^!\[([^\]]*)\]\(([^)]+)\)$", line.strip())
        if m:
            src = m.group(2)
            slug = pathlib.Path(src).stem
            if slug in DIAGRAMS:
                out.append(f'<figure class="diagram">{build_svg(slug)}</figure>')
            else:
                out.append(f'<figure><img src="{esc(src)}" alt="{esc(m.group(1))}"></figure>')
            i += 1
            continue
        lm = re.match(r"^(\s*)(-|\d+\.) ", line)
        if lm:
            ordered = lm.group(2) != "-"
            items, j = [], i
            while j < len(lines):
                im = re.match(r"^(-|\d+\.) (.*)$", lines[j])
                if im and (im.group(1) == "-") != ordered:
                    item = [im.group(2)]
                    j += 1
                    while j < len(lines) and (lines[j].startswith("   ") or lines[j].startswith("  ") or
                                              (not lines[j].strip() and j + 1 < len(lines) and lines[j + 1].startswith("  "))):
                        item.append(re.sub(r"^ {2,3}", "", lines[j]))
                        j += 1
                    items.append(item)
                else:
                    break
            tag = "ol" if ordered else "ul"
            lis = []
            for item in items:
                if len(item) == 1:
                    lis.append(f"<li>{inline(item[0], ctx)}</li>")
                else:
                    first, rest = item[0], item[1:]
                    lis.append(f"<li><p>{inline(first, ctx)}</p>{blocks(rest, ctx)}</li>")
            out.append(f"<{tag}>{''.join(lis)}</{tag}>")
            i = j
            continue
        j = i
        para = []
        while j < len(lines) and lines[j].strip() and not re.match(r"^(```|#|>|\||- |\d+\. |!\[)", lines[j]):
            para.append(lines[j].strip())
            j += 1
        out.append(f"<p>{inline(' '.join(para), ctx)}</p>")
        i = j
    return "".join(out)


CALLOUTS = {"Check": "check", "Note": "note", "Tip": "tip", "Before you start": "before"}


def callout(lines, ctx):
    kind, title = "note", None
    m = re.match(r"^\*\*([^*]+)\*\*\s*$", lines[0]) if lines else None
    if m and m.group(1) in CALLOUTS:
        title, kind = m.group(1), CALLOUTS[m.group(1)]
        lines = lines[1:]
    head = f'<div class="label">{esc(title)}</div>' if title else ""
    return f'<div class="callout {kind}">{head}{blocks(lines, ctx)}</div>'


