def page(index, md):
    names = {g[0] for g in GUIDES}
    lines = md.split("\n")
    title_line = lines[0].lstrip("# ").strip()
    title = title_line.split(":", 1)[1].strip() if ":" in title_line else title_line
    if "-" not in title.split()[0]:  # an app name such as boarding-api stays as written
        title = title[0].upper() + title[1:]
    body = lines[1:]
    # The first paragraph is the dek.
    k = 0
    while not body[k].strip():
        k += 1
    j = k
    while j < len(body) and body[j].strip():
        j += 1
    dek = inline(" ".join(l.strip() for l in body[k:j]), names)
    rest = body[j:]
    # Split at level-2 headings. Inside fenced code a '## ' line is code, never a heading.
    pre, sections, cur, fence = [], [], None, False
    for line in rest:
        if line.startswith("```"):
            fence = not fence
        if not fence and line.startswith("## "):
            cur = [line[3:].strip(), []]
            sections.append(cur)
        elif cur is None:
            pre.append(line)
        else:
            cur[1].append(line)
    parts = [blocks(pre, names)]
    for head, content in sections:
        m = re.match(r"^(\d+)\. (.*)$", head)
        if m:
            num, text_ = m.groups()
            tag = ""
            tm = re.match(r"^(Ground|Flight): (.*)$", text_)
            if tm:
                tag = f'<span class="tag {tm.group(1).lower()}">{tm.group(1)}</span>'
                text_ = tm.group(2)[:1].upper() + tm.group(2)[1:]
            parts.append(f'<section class="step"><span class="num">{int(num):02d}</span>'
                         f"<h2>{tag}{inline(text_, names)}</h2>{blocks(content, names)}</section>")
        else:
            cls = ' class="remember"' if head == "Remember" else ""
            keep = [l for l in content if not l.startswith("Next: ")]
            parts.append(f"<section{cls}><h2>{inline(head, names)}</h2>{blocks(keep, names)}</section>")
    prev_ = GUIDES[index - 1] if index > 0 else None
    next_ = GUIDES[index + 1] if index + 1 < len(GUIDES) else None
    nav = '<nav class="parts">'
    if prev_:
        nav += f'<a href="{prev_[0][:-3]}.html"><span class="k">← Part {index}</span>{esc(prev_[2])}</a>'
    if next_:
        nav += f'<a class="next" href="{next_[0][:-3]}.html"><span class="k">Part {index + 2} →</span>{esc(next_[2])}</a>'
    nav += "</nav>"
    src = GUIDES[index][0]
    return f"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Airframe Quickstart {index + 1}</title>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>{CSS.replace("{DARK}", "{" + DARK_VARS + "}")}</style>
</head>
<body>
<div class="wrap">
<header class="masthead">
<p class="eyebrow">Airframe quickstart · part {index + 1} of {len(GUIDES)}</p>
<h1>{esc(title)}</h1>
<p class="dek">{dek}</p>
</header>
{"".join(parts)}
{nav}
<footer><span>Hangar · Airframe · developer guide</span><span>Generated from <a href="../{src}">{src}</a> by tools/build-quickstart-docs</span></footer>
</div>
</body>
</html>
"""


def outputs():
    files = {}
    for i, (md, slug, _) in enumerate(GUIDES):
        files[USER / "diagrams" / f"{slug}.svg"] = build_svg(slug)
        files[USER / "html" / (md[:-3] + ".html")] = page(i, (USER / md).read_text())
    return files


def main(argv):
    check = "--check" in argv
    stale = []
    for p, content in outputs().items():
        if check:
            if not p.exists() or p.read_text() != content:
                stale.append(p.relative_to(ROOT))
        else:
            p.parent.mkdir(parents=True, exist_ok=True)
            p.write_text(content)
            print(f"wrote {p.relative_to(ROOT)}")
    if stale:
        print("out of date (run tools/build-quickstart-docs):", *stale, sep="\n  ")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
