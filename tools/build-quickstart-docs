# --- diagram primitives ------------------------------------------------------------------------

PAPER = "#f2efe9"; INK = "#1b1f24"; MUTED = "#5b6570"; SOFT = "#838b93"; ACC = "#b9791f"; LINK = "#2e7ba6"
SANS = "'Geist', system-ui, sans-serif"; MONO = "'Geist Mono', ui-monospace, monospace"
SERIF = "'Instrument Serif', Georgia, serif"

KINDS = {  # fill, stroke, dash
    "backend": ("#ffffff", INK, None),
    "focal": ("rgba(185,121,31,0.08)", ACC, None),
    "store": ("rgba(27,31,36,0.05)", MUTED, None),
    "input": ("rgba(91,101,112,0.10)", SOFT, None),
    "request": ("rgba(46,123,166,0.10)", LINK, None),
    "faded": ("rgba(27,31,36,0.02)", "rgba(27,31,36,0.25)", "4,3"),
}
ARROWS = {"muted": (MUTED, "qd-arrow"), "accent": (ACC, "qd-arrow-accent"), "link": (LINK, "qd-arrow-link")}

DARK = {PAPER: "#131619", "#ffffff": "#1c2127", INK: "#e8e4dc", MUTED: "#a1aab3", SOFT: "#7f8891",
        ACC: "#e8a33d", LINK: "#6fb2d9"}
RGBA_DARK = {(27, 31, 36): ((232, 228, 220), 1.0), (185, 121, 31): ((232, 163, 61), 1.3),
             (91, 101, 112): ((161, 170, 179), 1.0), (46, 123, 166): ((111, 178, 217), 1.3)}


def esc(s):
    return html.escape(s, quote=False)


def up4(v):
    return int(math.ceil(v / 4.0) * 4)


def text(x, y, s, size=12, weight=400, fill=INK, anchor="start", font=SANS, ls=None, italic=False):
    extra = (f' letter-spacing="{ls}"' if ls else "") + (' font-style="italic"' if italic else "")
    return (f'<text x="{x:g}" y="{y:g}" fill="{fill}" font-size="{size}" font-weight="{weight}" '
            f'font-family="{font}" text-anchor="{anchor}"{extra}>{esc(s)}</text>')


def node(x, y, w, h, name, sub=None, kind="backend", tag=None):
    fill, stroke, dash = KINDS[kind]
    assert len(name) * 6.9 <= w - 16, f"name too wide for its box: {name}"
    if sub:
        assert len(sub) * 5.2 <= w - 12, f"sub too wide for its box: {sub}"
    d = f' stroke-dasharray="{dash}"' if dash else ""
    s = f'<rect x="{x}" y="{y}" width="{w}" height="{h}" rx="6" fill="{PAPER}"/>'
    s += f'<rect x="{x}" y="{y}" width="{w}" height="{h}" rx="6" fill="{fill}" stroke="{stroke}" stroke-width="1"{d}/>'
    cx = x + w / 2
    if tag:
        tw = up4(len(tag) * 5.6 + 10)
        s += (f'<rect x="{x + 8}" y="{y + 7}" width="{tw}" height="13" rx="2" fill="none" stroke="{stroke}" '
              f'stroke-width="0.8"/>' + text(x + 8 + tw / 2, y + 16.5, tag.upper(), 7.5, 500, stroke, "middle", MONO, "0.08em"))
        ny = y + h / 2 + (6 if sub else 10)
    else:
        ny = y + h / 2 + (-3 if sub else 4)
    s += text(cx, ny, name, 12.5, 600, INK, "middle")
    if sub:
        s += text(cx, ny + 16, sub, 8.5, 400, MUTED, "middle", MONO)
    return s


def zone(x, y, w, h, label):
    lw = up4(len(label) * 5.4 + 14)
    return (f'<rect x="{x}" y="{y}" width="{w}" height="{h}" rx="8" fill="rgba(27,31,36,0.02)" '
            f'stroke="rgba(27,31,36,0.18)" stroke-width="0.8" stroke-dasharray="3,3"/>'
            f'<rect x="{x + 12}" y="{y - 6}" width="{lw}" height="12" rx="2" fill="{PAPER}"/>'
            + text(x + 12 + lw / 2, y + 3, label, 7.5, 500, MUTED, "middle", MONO, "0.12em"))


def rounded(points, r=8):
    d = f"M{points[0][0]},{points[0][1]}"
    for i in range(1, len(points) - 1):
        (x0, y0), (x1, y1), (x2, y2) = points[i - 1], points[i], points[i + 1]
        rr = min(r, (abs(x1 - x0) + abs(y1 - y0)) / 2, (abs(x2 - x1) + abs(y2 - y1)) / 2)
        sx1, sy1 = (x1 > x0) - (x1 < x0), (y1 > y0) - (y1 < y0)
        sx2, sy2 = (x2 > x1) - (x2 < x1), (y2 > y1) - (y2 < y1)
        d += f" L{x1 - sx1 * rr:g},{y1 - sy1 * rr:g} Q{x1},{y1} {x1 + sx2 * rr:g},{y1 + sy2 * rr:g}"
    for (ax, ay), (bx, by) in zip(points, points[1:]):
        assert ax == bx or ay == by, f"diagonal segment {ax},{ay} -> {bx},{by}"
    return d + f" L{points[-1][0]},{points[-1][1]}"


def path(points, color="muted", dashed=False):
    c, m = ARROWS[color]
    da = ' stroke-dasharray="5,4"' if dashed else ""
    return f'<path d="{rounded(points)}" fill="none" stroke="{c}" stroke-width="1.2"{da} marker-end="url(#{m})"/>'


def label(cx, top, s, color=SOFT):
    w = up4(len(s) * 5.5 + 10)
    return (f'<rect x="{cx - w / 2:g}" y="{top}" width="{w}" height="13" rx="2" fill="{PAPER}"/>'
            + text(cx, top + 9.5, s.upper(), 7.5, 500, color, "middle", MONO, "0.06em"))


def dark_colour(c):
    if c in DARK:
        return DARK[c]
    m = re.fullmatch(r"rgba\((\d+),\s*(\d+),\s*(\d+),\s*([\d.]+)\)", c)
    if m:
        rgb = tuple(int(v) for v in m.groups()[:3])
        if rgb in RGBA_DARK:
            (r, g, b), k = RGBA_DARK[rgb]
            return f"rgba({r},{g},{b},{min(1.0, float(m.group(4)) * k):.3g})"
    return None


def svg(slug, title, desc, w, h, body):
    """A standalone SVG. Its <style> maps each colour it uses to the dark palette, scoped to this
    diagram's id so several can share one HTML page."""
    defs = "".join(
        f'<marker id="{m}" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">'
        f'<polygon points="0 0, 8 3, 0 6" fill="{c}"/></marker>' for c, m in ARROWS.values())
    content = f'<rect width="{w}" height="{h}" fill="{PAPER}"/>' + body
    rules = []
    for attr, val in sorted(set(re.findall(r'\b(fill|stroke)="([^"]+)"', defs + content))):
        d = dark_colour(val)
        if d:
            rules.append(f'[{attr}="{val}"]{{{attr}:{d}}}')
    sel = f"#{slug}"
    style = (f"@media (prefers-color-scheme:dark){{"
             + " ".join(f":root:not([data-theme=light]) {sel} {r.split('{')[0]},svg{sel}:root {r}" for r in rules) + "}"
             + " ".join(f"[data-theme=dark] {sel} {r}" for r in rules))
    return (f'<svg xmlns="http://www.w3.org/2000/svg" id="{slug}" class="qd" viewBox="0 0 {w} {h}" '
            f'role="img" aria-labelledby="{slug}-t {slug}-d">'
            f'<title id="{slug}-t">{esc(title)}</title><desc id="{slug}-d">{esc(desc)}</desc>'
            f"<style>{style}</style><defs>{defs}</defs>{content}</svg>\n")


